#version 460
#extension GL_EXT_nonuniform_qualifier : require

// The two T#s are passed as root constants in s4..s19, exactly as written by CreateUnorderedAccessView.
layout(local_size_x = 1) in;
layout(push_constant) uniform UserData { uint s[20]; } pc;
layout(set = 0, binding = 2, std430) readonly buffer DescriptorMap { uint words[]; };
layout(set = 0, binding = 8, r32f) uniform image2D depths[];
layout(set = 0, binding = 9, r8ui) uniform uimage2D stencils[];

uint lookup(uint first) {
    uint hash = 2166136261u;
    for (uint i = 0; i < 8; ++i) hash = (hash ^ pc.s[first + i]) * 16777619u;
    for (uint probe = 0; probe < 8; ++probe) {
        uint slot = 1 + ((hash + probe) & words[0]) * 10;
        bool equal = true;
        for (uint i = 0; i < 8; ++i) equal = equal && words[slot + i] == pc.s[first + i];
        if (equal) return words[slot + 8];
    }
    return 0;
}

void main() {
    // Read before writing. A stale copy (or writing back the wrong plane) changes the expected bytes.
    uint depth = lookup(4), stencil = lookup(12);
    float before = imageLoad(depths[depth], ivec2(2, 1)).r;
    uint mask = imageLoad(stencils[stencil], ivec2(5, 3)).r;
    imageStore(depths[depth], ivec2(2, 1), vec4(before * 0.25));
    imageStore(stencils[stencil], ivec2(5, 3), uvec4(mask ^ 0xffu));
}
